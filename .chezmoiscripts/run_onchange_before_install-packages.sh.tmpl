#!/usr/bin/env bash

# Runs `brew bundle` whenever the Brewfile changes.
#
# This script is managed by chezmoi as a `run_onchange_` hook: chezmoi
# re-runs it only when its rendered content changes. Because the Brewfile
# is embedded below via `include`, editing the Brewfile changes this
# script's content and triggers a re-run on the next `chezmoi apply`.

set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
	echo "Homebrew not found — skipping brew bundle."
	echo "Install it first with script/install_brew.sh, then run 'chezmoi apply' again."
	exit 0
fi

# The Brewfile is embedded here so this script's content changes with it.
read -r -d '' BREWFILE <<'EOF' || true
{{ include "Brewfile" }}
EOF

# Homebrew requires third-party taps to be trusted before it will load their
# formulae (HOMEBREW_REQUIRE_TAP_TRUST, on by default). Trust every tap listed
# in the Brewfile so `brew bundle` doesn't abort on a fresh machine.
# `brew trust` is idempotent.
while read -r tap; do
	[ -n "$tap" ] && brew trust "$tap"
done < <(printf '%s\n' "$BREWFILE" | sed -n "s/^tap ['\"]\([^'\"]*\)['\"].*/\1/p")

echo "Brewfile changed — running brew bundle..."

printf '%s\n' "$BREWFILE" | brew bundle --file=/dev/stdin
