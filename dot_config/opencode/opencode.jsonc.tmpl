{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
{{- if .haMcpUrl }}
      // The URL is asked for by `chezmoi init` and stored outside this repo.
      // Disabled globally; enabled by a project config in the HA folder.
      "ha-mcp": {
        "type": "remote",
        "url": {{ .haMcpUrl | quote }},
        "disabled": true,
      },
{{- end }}
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
      },
    },
  },
}
