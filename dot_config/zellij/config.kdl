keybinds clear-defaults=true {
    locked {
        bind "Ctrl a" { SwitchToMode "normal"; }
    }
    normal {
        // Ctrl a, w: switch between project sessions
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        // Ctrl a, f: fuzzy-find a tab by name
        bind "f" {
            LaunchOrFocusPlugin "room" {
                floating true
                ignore_case true
                quick_jump true
            }
            SwitchToMode "locked"
        }
        // Ctrl a, g: lazygit in a floating pane, in the focused pane's folder
        bind "g" {
            Run "lazygit" {
                floating true
                close_on_exit true
                width "90%"
                height "90%"
                x "5%"
                y "5%"
            }
            SwitchToMode "locked"
        }
        // Ctrl a, ?: cheatsheet
        bind "?" {
            Run "bash" "-c" "bat --style=plain --paging=always --language=markdown \"$HOME/.config/zellij/cheatsheet.md\"" {
                floating true
                close_on_exit true
                width "80%"
                height "80%"
                x "10%"
                y "10%"
            }
            SwitchToMode "locked"
        }
        // Ctrl a, [ / ]: cycle pane arrangements (stays in normal mode to repeat)
        bind "[" { PreviousSwapLayout; }
        bind "]" { NextSwapLayout; }
    }
    pane {
        bind "left" { MoveFocus "left"; }
        bind "down" { MoveFocus "down"; }
        bind "up" { MoveFocus "up"; }
        bind "right" { MoveFocus "right"; }
        bind ";" { FocusLastPane; }
        bind "c" { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "d" { NewPane "down"; SwitchToMode "locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "Shift f" { ToggleFocusNoUiFullscreen; SwitchToMode "locked"; }
        bind "h" { MoveFocus "left"; }
        bind "i" { TogglePanePinned; SwitchToMode "locked"; }
        bind "j" { MoveFocus "down"; }
        bind "k" { MoveFocus "up"; }
        bind "l" { MoveFocus "right"; }
        bind "n" { NewPane; SwitchToMode "locked"; }
        bind "p" { SwitchToMode "normal"; }
        bind "r" { NewPane "right"; SwitchToMode "locked"; }
        bind "s" { NewPane "stacked"; SwitchToMode "locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "x" { CloseFocus; SwitchToMode "locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "locked"; }
        bind "tab" { SwitchFocus; }
    }
    tab {
        bind "left" { GoToPreviousTab; }
        bind "down" { GoToNextTab; }
        bind "up" { GoToPreviousTab; }
        bind "right" { GoToNextTab; }
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }
        bind "[" { BreakPaneLeft; SwitchToMode "locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "locked"; }
        bind "b" { BreakPane; SwitchToMode "locked"; }
        bind "h" { GoToPreviousTab; }
        bind "j" { GoToNextTab; }
        bind "k" { GoToPreviousTab; }
        bind "l" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "locked"; }
        bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "locked"; }
        bind "t" { SwitchToMode "normal"; }
        bind "x" { CloseTab; SwitchToMode "locked"; }
        bind "tab" { ToggleTab; }
    }
    resize {
        bind "left" { Resize "Increase left"; }
        bind "down" { Resize "Increase down"; }
        bind "up" { Resize "Increase up"; }
        bind "right" { Resize "Increase right"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "=" { Resize "Increase"; }
        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "h" { Resize "Increase left"; }
        bind "j" { Resize "Increase down"; }
        bind "k" { Resize "Increase up"; }
        bind "l" { Resize "Increase right"; }
        bind "r" { SwitchToMode "normal"; }
    }
    move {
        bind "left" { MovePane "left"; }
        bind "down" { MovePane "down"; }
        bind "up" { MovePane "up"; }
        bind "right" { MovePane "right"; }
        bind "h" { MovePane "left"; }
        bind "j" { MovePane "down"; }
        bind "k" { MovePane "up"; }
        bind "l" { MovePane "right"; }
        bind "m" { SwitchToMode "normal"; }
        bind "n" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "tab" { MovePane; }
    }
    scroll {
        bind "Alt left" { MoveFocusOrTab "left"; SwitchToMode "locked"; }
        bind "Alt down" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Alt up" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Alt right" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        bind "c" { CopyLastCommandOutput; SwitchToMode "locked"; }
        bind "e" { EditScrollback; SwitchToMode "locked"; }
        bind "f" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Alt h" { MoveFocusOrTab "left"; SwitchToMode "locked"; }
        bind "Alt j" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Alt k" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Alt l" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        bind "s" { SwitchToMode "normal"; }
    }
    search {
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "n" { Search "down"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "p" { Search "up"; }
        bind "w" { SearchToggleOption "Wrap"; }
    }
    session {
        bind "[" { FocusGuestSession; SwitchToMode "normal"; }
        bind "]" { FocusHostSession; SwitchToMode "normal"; }
        bind "a" {
            LaunchOrFocusPlugin "zellij:about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "d" { Detach; }
        bind "f" { ToggleHostFullscreen; SwitchToMode "normal"; }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "o" { SwitchToMode "normal"; }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "s" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
    }
    shared_among "normal" "locked" {
        // Seamless navigation between zellij panes and nvim splits (smart-splits.nvim)
        bind "Ctrl h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "left";
                move_mod "ctrl";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
                move_mod "ctrl";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
                move_mod "ctrl";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "right";
                move_mod "ctrl";
            };
        }
        bind "Alt left" { MoveFocusOrTab "left"; }
        bind "Alt down" { MoveFocus "down"; }
        bind "Alt up" { MoveFocus "up"; }
        bind "Alt right" { MoveFocusOrTab "right"; }
        bind "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt h" { MoveFocusOrTab "left"; }
        bind "Alt i" { MoveTab "left"; }
        bind "Alt j" { MoveFocus "down"; }
        bind "Alt k" { MoveFocus "up"; }
        bind "Alt l" { MoveFocusOrTab "right"; }
        bind "Alt n" { NewPane; }
        bind "Alt o" { MoveTab "right"; }
        bind "Alt p" { TogglePaneInGroup; }
        bind "Alt Shift p" { ToggleGroupMarking; }
    }
    shared_except "locked" "renametab" "renamepane" {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl q" { Quit; }
    }
    shared_except "locked" "entersearch" {
        bind "enter" { SwitchToMode "locked"; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" {
        bind "esc" { SwitchToMode "locked"; }
    }
    shared_except "locked" "entersearch" "search" "renametab" "renamepane" "session" {
        bind "o" { SwitchToMode "session"; }
    }
    shared_except "locked" "scroll" "entersearch" "search" "renametab" "renamepane" "move" {
        bind "m" { SwitchToMode "move"; }
    }
    shared_except "locked" "tab" "entersearch" "renametab" "renamepane" {
        bind "t" { SwitchToMode "tab"; }
    }
    shared_among "normal" "resize" "tab" "scroll" "prompt" "tmux" {
        bind "p" { SwitchToMode "pane"; }
    }
    shared_among "normal" "resize" "search" "move" "prompt" "tmux" {
        bind "s" { SwitchToMode "scroll"; }
    }
    shared_except "locked" "resize" "pane" "tab" "entersearch" "renametab" "renamepane" {
        bind "r" { SwitchToMode "resize"; }
    }
    shared_among "scroll" "search" {
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "left" { PageScrollUp; }
        bind "down" { ScrollDown; }
        bind "up" { ScrollUp; }
        bind "right" { PageScrollDown; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "Ctrl b" { PageScrollUp; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
        bind "d" { HalfPageScrollDown; }
        bind "Ctrl f" { PageScrollDown; }
        bind "h" { PageScrollUp; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "l" { PageScrollDown; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "u" { HalfPageScrollUp; }
    }
    entersearch {
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "esc" { SwitchToMode "scroll"; }
        bind "enter" { SwitchToMode "search"; }
    }
    renametab {
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" { SwitchToMode "locked"; }
    }
    renamepane {
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
}

// Plugin aliases (changing these requires a restart)
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    room location="https://github.com/rvcas/room/releases/download/v1.2.1/room.wasm"
    // Catppuccin Macchiato status bar, used by the layouts as plugin location="zjstatus".
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
        format_left   "#[fg=#8aadf4,bold] {session} {mode}"
        format_center "{tabs}"
        format_right  "{command_agents}{datetime}"
        format_space  ""

        // Long key hints win over the tabs: hide the center first, then the right.
        format_hide_on_overlength "true"
        format_precedence         "lrc"

        border_enabled "false"

        mode_locked        "#[fg=#6e738d]󰌾 "
        // Key hints for each mode (which-key style). Update them when keybindings change.
        mode_normal        "#[bg=#a6da95,fg=#24273a,bold] NORMAL #[fg=#c6a0f6,bold] w #[fg=#a5adcb]sessions  #[fg=#c6a0f6,bold]f #[fg=#a5adcb]find tab  #[fg=#c6a0f6,bold]g #[fg=#a5adcb]lazygit  #[fg=#c6a0f6,bold][ ] #[fg=#a5adcb]layout  #[fg=#c6a0f6,bold]p #[fg=#a5adcb]pane  #[fg=#c6a0f6,bold]t #[fg=#a5adcb]tab  #[fg=#c6a0f6,bold]r #[fg=#a5adcb]resize  #[fg=#c6a0f6,bold]m #[fg=#a5adcb]move  #[fg=#c6a0f6,bold]s #[fg=#a5adcb]scroll  #[fg=#c6a0f6,bold]o #[fg=#a5adcb]session  #[fg=#c6a0f6,bold]? #[fg=#a5adcb]help  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]back "
        mode_pane          "#[bg=#8aadf4,fg=#24273a,bold] PANE #[fg=#c6a0f6,bold] n #[fg=#a5adcb]new  #[fg=#c6a0f6,bold]r #[fg=#a5adcb]right  #[fg=#c6a0f6,bold]d #[fg=#a5adcb]down  #[fg=#c6a0f6,bold]s #[fg=#a5adcb]stacked  #[fg=#c6a0f6,bold]x #[fg=#a5adcb]close  #[fg=#c6a0f6,bold]f #[fg=#a5adcb]fullscreen  #[fg=#c6a0f6,bold]w #[fg=#a5adcb]floating  #[fg=#c6a0f6,bold]e #[fg=#a5adcb]float/embed  #[fg=#c6a0f6,bold]i #[fg=#a5adcb]pin  #[fg=#c6a0f6,bold]c #[fg=#a5adcb]rename  #[fg=#c6a0f6,bold]hjkl #[fg=#a5adcb]focus  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]back "
        mode_tab           "#[bg=#c6a0f6,fg=#24273a,bold] TAB #[fg=#c6a0f6,bold] n #[fg=#a5adcb]new  #[fg=#c6a0f6,bold]x #[fg=#a5adcb]close  #[fg=#c6a0f6,bold]r #[fg=#a5adcb]rename  #[fg=#c6a0f6,bold]1-9 #[fg=#a5adcb]go to  #[fg=#c6a0f6,bold]hjkl #[fg=#a5adcb]switch  #[fg=#c6a0f6,bold]tab #[fg=#a5adcb]last  #[fg=#c6a0f6,bold]b #[fg=#a5adcb]break out  #[fg=#c6a0f6,bold][ ] #[fg=#a5adcb]break left/right  #[fg=#c6a0f6,bold]s #[fg=#a5adcb]sync  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]back "
        mode_resize        "#[bg=#f5a97f,fg=#24273a,bold] RESIZE #[fg=#c6a0f6,bold] hjkl #[fg=#a5adcb]grow  #[fg=#c6a0f6,bold]HJKL #[fg=#a5adcb]shrink  #[fg=#c6a0f6,bold]+ - #[fg=#a5adcb]size  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]back "
        mode_move          "#[bg=#f5a97f,fg=#24273a,bold] MOVE #[fg=#c6a0f6,bold] hjkl #[fg=#a5adcb]move  #[fg=#c6a0f6,bold]n #[fg=#a5adcb]next  #[fg=#c6a0f6,bold]p #[fg=#a5adcb]previous  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]back "
        mode_scroll        "#[bg=#eed49f,fg=#24273a,bold] SCROLL #[fg=#c6a0f6,bold] j k #[fg=#a5adcb]line  #[fg=#c6a0f6,bold]d u #[fg=#a5adcb]half page  #[fg=#c6a0f6,bold]h l #[fg=#a5adcb]page  #[fg=#c6a0f6,bold][ ] #[fg=#a5adcb]prompts  #[fg=#c6a0f6,bold]f #[fg=#a5adcb]search  #[fg=#c6a0f6,bold]e #[fg=#a5adcb]open in nvim  #[fg=#c6a0f6,bold]c #[fg=#a5adcb]copy output  #[fg=#c6a0f6,bold]ctrl c #[fg=#a5adcb]bottom  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]back "
        mode_search        "#[bg=#eed49f,fg=#24273a,bold] SEARCH #[fg=#c6a0f6,bold] n #[fg=#a5adcb]next  #[fg=#c6a0f6,bold]p #[fg=#a5adcb]previous  #[fg=#c6a0f6,bold]c #[fg=#a5adcb]case  #[fg=#c6a0f6,bold]w #[fg=#a5adcb]wrap  #[fg=#c6a0f6,bold]o #[fg=#a5adcb]whole word  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]back "
        mode_enter_search  "#[bg=#eed49f,fg=#24273a,bold] SEARCH #[fg=#c6a0f6,bold] type #[fg=#a5adcb]query  #[fg=#c6a0f6,bold]enter #[fg=#a5adcb]search  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]cancel "
        mode_rename_tab    "#[bg=#f5bde6,fg=#24273a,bold] RENAME TAB #[fg=#c6a0f6,bold] type #[fg=#a5adcb]name  #[fg=#c6a0f6,bold]enter #[fg=#a5adcb]save  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]undo "
        mode_rename_pane   "#[bg=#f5bde6,fg=#24273a,bold] RENAME PANE #[fg=#c6a0f6,bold] type #[fg=#a5adcb]name  #[fg=#c6a0f6,bold]enter #[fg=#a5adcb]save  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]undo "
        mode_session       "#[bg=#ed8796,fg=#24273a,bold] SESSION #[fg=#c6a0f6,bold] w #[fg=#a5adcb]manager  #[fg=#c6a0f6,bold]d #[fg=#a5adcb]detach  #[fg=#c6a0f6,bold]l #[fg=#a5adcb]layouts  #[fg=#c6a0f6,bold]c #[fg=#a5adcb]config  #[fg=#c6a0f6,bold]p #[fg=#a5adcb]plugins  #[fg=#c6a0f6,bold]esc #[fg=#a5adcb]back "
        mode_prompt        "#[bg=#ed8796,fg=#24273a,bold] PROMPT "

        tab_normal              "#[fg=#6e738d] {index} {name}{floating_indicator}{fullscreen_indicator} "
        tab_active              "#[bg=#363a4f,fg=#cad3f5,bold] {index} {name}{floating_indicator}{fullscreen_indicator} "
        tab_separator           " "
        tab_floating_indicator  " 󰉈"
        tab_fullscreen_indicator " 󰊓"

        // opencode state per session, from ~/.local/bin/zellij-agent-state
        command_agents_command    "bash -c \"$HOME/.local/bin/zellij-agent-state render\""
        command_agents_format     "{stdout}"
        command_agents_interval   "2"
        command_agents_rendermode "dynamic"

        datetime          "#[fg=#6e738d] {format} "
        datetime_format   "%a %d %b  %H:%M"
        datetime_timezone "Europe/Oslo"
    }
}

// Plugins loaded in the background when a session starts
load_plugins {
    zellij:link
}

web_client {
    font "monospace"
}

// All other options use the defaults: https://zellij.dev/documentation/options
theme "catppuccin-macchiato"
default_mode "locked"
pane_frames false
show_startup_tips false

// Save sessions (tabs, panes, cwds, commands) so they can be resurrected after
// a reboot from the session manager (Ctrl a, w). Commands come back suspended.
session_serialization true
