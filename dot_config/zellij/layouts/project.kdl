layout {
  default_tab_template {
    children
    pane size=1 borderless=true {
        plugin location="zjstatus"
    }
  }
  tab name="Editor" focus=true {
    pane command="nvim"
  }
  tab name="opencode" {
    pane command="opencode"
  }
  tab name="Shell" {
    pane split_direction="vertical" {
      pane
      pane
    }
  }
}
