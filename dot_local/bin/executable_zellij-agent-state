#!/usr/bin/env bash
# Tracks the state of opencode agents per zellij session, for the zjstatus bar,
# and sends a macOS notification when one finishes or needs you.
#
#   zellij-agent-state set <working|waiting|done|error> <pid> [message]
#   zellij-agent-state clear <pid>
#       Called by the opencode plugin in ~/.config/opencode/plugins/zellij-agent-state.
#   zellij-agent-state render
#       Called by zjstatus every few seconds. Prints the status bar segment.

set -u

dir="${XDG_STATE_HOME:-$HOME/.local/state}/zellij-agents"
mkdir -p "$dir"

session="${ZELLIJ_SESSION_NAME:-}"

# True when the person is looking at this pane: Ghostty is the frontmost app and
# an attached zellij client has this pane focused.
watching() {
	[ -n "${ZELLIJ_PANE_ID:-}" ] || return 1
	case "$(lsappinfo info -only name "$(lsappinfo front)" 2>/dev/null)" in
	*Ghostty*) ;;
	*) return 1 ;;
	esac
	zellij action list-clients 2>/dev/null |
		awk -v pane="terminal_$ZELLIJ_PANE_ID" 'NR > 1 && $2 == pane { found = 1 } END { exit !found }'
}

notify() {
	local state=$1 message=$2 body sound
	case "$state" in
	waiting) body="Needs your input" sound="Glass" ;;
	done) body="Finished" sound="Tink" ;;
	error) body="Stopped with an error" sound="Basso" ;;
	*) return ;;
	esac
	[ -n "$message" ] && body="$body: $message"
	watching && return
	osascript - "opencode" "$session" "$body" "$sound" >/dev/null 2>&1 <<'EOF'
on run argv
	display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv) sound name (item 4 of argv)
end run
EOF
}

render() {
	local f name s pid state rank
	for f in "$dir"/*; do
		[ -e "$f" ] || continue
		name=${f##*/}
		s=${name%.*}
		pid=${name##*.}
		if ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$f"
			continue
		fi
		state=$(<"$f")
		case "$state" in
		waiting) rank=0 ;;
		error) rank=1 ;;
		done) rank=2 ;;
		working) rank=3 ;;
		*) continue ;;
		esac
		printf '%s %s %s\n' "$s" "$rank" "$state"
	done |
		sort -k1,1 -k2,2n |
		awk '
			!seen[$1]++ {
				if ($3 == "waiting") style = "#[fg=#ed8796,bold]▲"
				else if ($3 == "error") style = "#[fg=#ed8796,bold]×"
				else if ($3 == "done") style = "#[fg=#a6da95]■"
				else style = "#[fg=#eed49f]●"
				printf "%s %s ", style, $1
			}
		'
}

case "${1:-}" in
set)
	[ -n "$session" ] && [ $# -ge 3 ] || exit 0
	printf '%s\n' "$2" >"$dir/$session.$3"
	notify "$2" "${4:-}"
	;;
clear)
	[ -n "$session" ] && [ $# -ge 2 ] || exit 0
	rm -f "$dir/$session.$2"
	;;
render)
	render
	;;
*)
	echo "usage: zellij-agent-state set <state> <pid> [message] | clear <pid> | render" >&2
	exit 2
	;;
esac
